StellarYieldsFilename = IndividualStarYields-Mix0.1.h5
StellarYieldsNumberOfSpecies = 12
StellarYieldsAtomicNumbers = 1 2 6 7 8 11 12 20 25 26 38 56
StarMakerMinimumMassRamp = 0
