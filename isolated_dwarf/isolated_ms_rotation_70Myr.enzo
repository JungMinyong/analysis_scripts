StaticRefineRegionRightEdge[3] = 0.53125 0.53125 0.53125
StaticRefineRegionLevel[4] = 4
StaticRefineRegionLeftEdge[4] = 0.484375 0.484375 0.484375
StaticRefineRegionRightEdge[4] = 0.515625 0.515625 0.515625
StaticRefineRegionLevel[5] = 5
StaticRefineRegionLeftEdge[5] = 0.4921875 0.4921875 0.4921875
StaticRefineRegionRightEdge[5] = 0.5078125 0.5078125 0.5078125
StaticRefineRegionLevel[6] = 6
StaticRefineRegionLeftEdge[6] = 0.49609375 0.49609375 0.49609375
StaticRefineRegionRightEdge[6] = 0.50390625 0.50390625 0.50390625

